# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
# Must match the port you run Payload on (e.g. http://localhost:8000 if you use `npm run dev:8000` while the marketing site uses port 3000).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Marketing frontend URL where Payload preview should open (your custom website app).
FRONTEND_APP_URL=http://localhost:3000

# Drizzle schema push on `next dev` boot. Leave false for faster admin; set true once after changing collections/fields, then back to false.
PAYLOAD_DATABASE_PUSH=false

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Push published posts/pages to marketing backend (Neon neondb) so the live site works without Payload
# Local dev:
BACKEND_API_URL=http://localhost:3001
# Production Payload admin (your PC) must use your Vercel site URL:
# BACKEND_API_URL=https://argroup-education-frontend.vercel.app
PAYLOAD_SYNC_SECRET=change-me-to-a-long-random-string
