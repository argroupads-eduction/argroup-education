# Vercel project: argroup-education-cms
# Dashboard → Settings → General → Root Directory = ar-group-of-eductions (no leading slash)
# Disable "Include files outside the Root Directory in the Build Step" for this project.
# Build uses ar-group-of-eductions/vercel.json (scripts/vercel-build.mjs).
#
# Database — Supabase transaction pooler (port 6543) or Neon pooled URL
# Supabase: Dashboard → Connect → Transaction pooler → URI
# Payload tables use schema `cms`; Prisma marketing tables use `public` (same database).
# Example: postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Payload admin URL (port 8000 when using npm run dev:cms)
NEXT_PUBLIC_SERVER_URL=http://localhost:8000
FRONTEND_APP_URL=http://localhost:3000

# Drizzle schema push on boot — set true once after collection changes, then false
PAYLOAD_DATABASE_PUSH=false

CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_SECRET_HERE

# Payload → marketing backend sync (required for live site updates)
BACKEND_API_URL=https://www.argroupofeducation.com
PAYLOAD_SYNC_SECRET=change-me-to-a-long-random-string

# Vercel Blob — REQUIRED for media uploads on argroup-education-cms*.vercel.app
# Without this, image upload shows "Something went wrong" in admin.
# Vercel dashboard → Storage → Blob → Create store → link to CMS project → copy token
BLOB_READ_WRITE_TOKEN=
