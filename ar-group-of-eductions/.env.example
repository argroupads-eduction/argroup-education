# Vercel project: argroup-education-cms
# Dashboard → Settings → General → Root Directory = ar-group-of-eductions (no leading slash)
# Disable "Include files outside the Root Directory in the Build Step" for this project.
# Build uses ar-group-of-eductions/vercel.json (scripts/vercel-build.mjs).
#
# Database — Supabase transaction pooler (port 6543) or Neon pooled URL
# Supabase: Dashboard → Connect → Transaction pooler → URI
# Payload tables use schema `cms`; Prisma marketing tables use `public` (same database).
# Example: postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Optional: CockroachDB Serverless (Postgres wire). See also `.env.cockroachdb`.
# DATABASE_URL=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
# Keep PAYLOAD_DATABASE_PUSH=false during cutover unless you intentionally sync schema.

# Used to encrypt JWT tokens
PAYLOAD_SECRET=SECRET_HERE

# Payload admin URL (port 8000 when using npm run dev:cms)
# Production CMS: set to public CMS URL (e.g. https://argroup-education-cms.vercel.app)
NEXT_PUBLIC_SERVER_URL=http://localhost:8000

# Drizzle schema push on boot — set true once after collection changes, then false
PAYLOAD_DATABASE_PUSH=false

# Required for Scheduled Publish on Vercel (Authorization: Bearer <CRON_SECRET>).
# Local: payload.config jobs.autoRun runs every minute (set DISABLE_PAYLOAD_JOBS_AUTORUN=true to stop).
CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_SECRET_HERE
# DISABLE_PAYLOAD_JOBS_AUTORUN=true

# Payload → marketing backend sync (required on Vercel CMS for Publish → live)
# Must match REVALIDATE_SECRET on the marketing frontend / apps/frontend/.env.production
# Local: http://localhost:3000 | Production: https://www.argroupofeducation.com
BACKEND_API_URL=http://localhost:3000
FRONTEND_APP_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-to-a-long-random-string

# --- Production Publish + Schedule checklist (CMS project on Vercel) ---
# 1) Publish → live: BACKEND_API_URL + REVALIDATE_SECRET must match marketing site.
#    NEXT_PUBLIC_SERVER_URL = public CMS URL (not localhost). Posts/Pages/globals sync on publish.
# 2) Schedule Publish: versions.drafts.schedulePublish is on for Posts + Pages.
#    vercel.json cron is daily on Hobby (0 6 * * *). For minute-accurate schedules:
#    use Vercel Pro (* * * * *) OR external cron → GET /api/cron/run-jobs
#    with Authorization: Bearer <CRON_SECRET> every minute.
# 3) Optional fallback: GET /api/payload-jobs/run with the same Bearer secret.
# 4) Cockroach cutover: set DATABASE_URL to Cockroach defaultdb (sslmode=require on Vercel).
#    Marketing Amplify can stay on current DB — CMS Publish still syncs via payload-sync.
#    Before the NEXT Amplify deploy: set Amplify DATABASE_URL (+ DATABASE_URL_UNPOOLED) to the
#    same Cockroach URL (Prisma provider is cockroachdb). Keep Supabase backup until stable.


# Vercel Blob — required for media uploads on argroup-education-cms.vercel.app
# Vercel → Storage → Blob → Connect to project → adds BLOB_READ_WRITE_TOKEN automatically
# Only BLOB_READ_WRITE_TOKEN is required. BLOB_STORE_ID / BLOB_WEBHOOK_PUBLIC_KEY are optional.
# On Vercel: client uploads are ON by default (browser → Blob). Do not set BLOB_CLIENT_UPLOADS=false unless debugging.
# Local dev: leave BLOB_READ_WRITE_TOKEN empty — uploads save to public/media/
BLOB_READ_WRITE_TOKEN=
# BLOB_CLIENT_UPLOADS=false
