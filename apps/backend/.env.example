# Hostinger MySQL (marketing frontend DB) — apps/backend/.env

# From hPanel → Databases → Remote MySQL hostname (NOT localhost for Node.js):
# DATABASE_URL=mysql://USER:PASSWORD@srvXXXX.hstgr.io:3306/DBNAME

DATABASE_URL=mysql://user:password@127.0.0.1:3306/ar_education

# Server (standalone Express — optional; Hostinger runs Next with /api routes)
PORT=3001
NODE_ENV=development

# Must match Hostinger frontend + Vercel CMS
PAYLOAD_SYNC_SECRET=change-me-to-a-long-random-string
REVALIDATE_SECRET=change-me-to-a-long-random-string
FRONTEND_REVALIDATE_URL=http://localhost:3000

CORS_ORIGIN=http://localhost:3000

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

LEADS_NOTIFY_EMAIL=argroupads@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AR Group of Education <argroupads@gmail.com>
EMAIL_OTP_FROM=AR Group of Education <info@argroupofeducation.com>

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=
OUTSCRAPER_API_KEY=
