# Copy into Hostinger Node app → Environment variables (never commit real secrets).
# CRITICAL: DATABASE_NAME must be a NEW empty MySQL database — NOT the marketing site DB
# (the one that already has BlogPost / SitePage / Prisma tables).

NODE_ENV=production
HOST=0.0.0.0
# Hostinger sets PORT at runtime — do not hardcode if panel injects it
PORT=1337

# Public URL of THIS Strapi app (subdomain), used for Media Library absolute URLs
PUBLIC_URL=https://cms.YOUR-DOMAIN-OR-HOSTINGER-SITE.com

# --- Strapi secrets (generate fresh for production; do not reuse local .env as-is if exposed) ---
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
ENCRYPTION_KEY=change-me-32chars-minimum!!!!
JWT_SECRET=change-me-jwt-secret

# --- Hostinger MySQL — SEPARATE database for Strapi only ---
DATABASE_CLIENT=mysql
DATABASE_HOST=srvXXXX.hstgr.io
# On Hostinger Node apps prefer: DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=uXXXXXXX_strapi
DATABASE_USERNAME=uXXXXXXX_cmsstrapi
DATABASE_PASSWORD=ArgroupCms2026Db
DATABASE_SSL=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5

# --- Live marketing sync (same as Step 4) ---
# Bypass Cloudflare ECONNRESET: call Hostinger origin IP with Host/SNI = www.
# (sync.argroupofeducation.com DNS-only alone is not enough until Hostinger
# also attaches that hostname + SSL to the marketing Node app.)
MARKETING_SYNC_URL=https://www.argroupofeducation.com
MARKETING_SYNC_ORIGIN=https://195.35.44.199
MARKETING_SYNC_HOST=www.argroupofeducation.com
STRAPI_ALLOW_LIVE_SYNC=1
PAYLOAD_SYNC_SECRET=same-as-frontend-PAYLOAD_SYNC_SECRET
# REQUIRED on Hostinger when HTTP to www/IP gets ECONNRESET (hairpin/Cloudflare):
# paste the SAME value as marketing site DATABASE_URL
MARKETING_DATABASE_URL=mysql://USER:PASS@srvXXXX.hstgr.io:3306/uXXXX_argroup
