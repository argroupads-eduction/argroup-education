{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post (Blog)",
    "description": "Mirrors Hostinger MySQL BlogPost - Step 3 local/staging only"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 500 },
    "slug": { "type": "string", "required": true, "unique": true, "maxLength": 255 },
    "content": {
      "type": "richtext",
      "required": true,
      "description": "Paste Markdown or HTML. Save/Publish → h2/h3/p lists + FAQs become live accordion (add a 'Frequently Asked Questions' heading, then Q then Answer)."
    },
    "excerpt": { "type": "text" },
    "featuredMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Import / upload featured image (hero). Auto-fills featuredImage URL for the live site."
    },
    "featuredImage": {
      "type": "text",
      "description": "Auto-filled from Featured media, or paste a public https URL"
    },
    "category": { "type": "string", "default": "Blog", "maxLength": 120 },
    "tags": { "type": "json" },
    "metaTitle": { "type": "string", "maxLength": 500 },
    "metaDescription": { "type": "text" },
    "canonicalUrl": { "type": "text" },
    "focusKeyword": { "type": "string", "maxLength": 255 },
    "keywords": { "type": "json" },
    "ogTitle": { "type": "string", "maxLength": 500 },
    "ogDescription": { "type": "text" },
    "ogImage": { "type": "text" },
    "twitterTitle": { "type": "string", "maxLength": 500 },
    "twitterDescription": { "type": "text" },
    "schemaJson": {
      "type": "json",
      "description": "Auto-generated Article (+ FAQ) JSON-LD on Save/Publish from title, slug, content, and image"
    },
    "author": { "type": "string", "default": "AR Group", "maxLength": 120 },
    "wpId": { "type": "integer", "unique": true },
    "mysqlId": { "type": "string", "private": true },
    "views": { "type": "integer", "default": 0 },
    "legacyPublishedAt": { "type": "datetime" }
  }
}
