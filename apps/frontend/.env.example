# Frontend Environment Variables
# Hostinger: import apps/frontend/.env.hostinger.example in hPanel → Environment variables.
# See docs/HOSTINGER_DEPLOY.md (marketing frontend on Hostinger; Payload CMS stays on Vercel).
#
# Local: copy to .env.local.

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=AR Group of Education

# Hostinger / production: leave NEXT_PUBLIC_API_URL empty — same-site /api/*
# NEXT_PUBLIC_SITE_URL=https://www.argroupofeducation.com
# WP_MEDIA_ORIGIN=https://www.argroupofeducation.com

# Hostinger MySQL
# DATABASE_URL=mysql://USER:PASSWORD@HOSTNAME:3306/DBNAME

# Google Sheets leads
# GOOGLE_SHEETS_WEBHOOK_URL=
# GOOGLE_SHEETS_WEBHOOK_SECRET=

# Form leads + SMTP
# LEADS_NOTIFY_EMAIL=argroupads@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=AR Group of Education <argroupads@gmail.com>
# CRON_SECRET=

# Shared with Vercel Payload CMS
# REVALIDATE_SECRET=
# PAYLOAD_SYNC_SECRET=
# PAYLOAD_CMS_URL=https://argroup-education-cms-livid.vercel.app
# PAYLOAD_CMS_ENABLED=false
# CONTENT_SOURCE=api

NEXT_PUBLIC_GA_ID=G-7RW8RDR90K
NEXT_PUBLIC_GTAG_ID=G-7RW8RDR90K

YOUTUBE_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=A R Group of Education Get MBBS Admission Counselling Sector 18 Noida

# PWA / Web Push
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:argroupads@gmail.com

NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Do NOT set on Hostinger: AWS_*, AMPLIFY_*, VERCEL, VERCEL_URL
