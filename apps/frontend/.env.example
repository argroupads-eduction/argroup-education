# Frontend Environment Variables
# Copy to .env.local for development. In production, set the same keys in Vercel → Environment Variables.
# See docs/VERCEL_DEPLOY.md for Root Directory (apps/frontend) and Railway backend URL.

# --- Local development (recommended: npm run dev from repo root = backend + frontend) ---
# CMS is optional. Only set these when Payload is running (npm run dev:with-cms + Postgres):
# NEXT_PUBLIC_CMS_URL=http://localhost:8000
# PAYLOAD_CMS_URL=http://127.0.0.1:8000
# Set to false to skip CMS calls and use built-in fallback forms (default when URLs are unset):
# PAYLOAD_CMS_ENABLED=false
# After `npm run wp:import:payload`, set PAYLOAD_CMS_ENABLED=true so /blog and pages read migrated htmlContent.
# API Configuration (local: separate Express on 3001)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel production: leave NEXT_PUBLIC_API_URL empty — blogs use same-site /api/* routes
# NEXT_PUBLIC_SITE_URL=https://argroupofeducation.com
# Legacy WordPress media (Hostinger/cPanel URL where wp-content still lives — required for college card images)
# WP_MEDIA_ORIGIN=https://your-wordpress-host.example.com
NEXT_PUBLIC_SITE_NAME=AR Group of Education

# API rate limit (Edge middleware) — per IP per minute
# RATE_LIMIT_API_MAX=120
# RATE_LIMIT_API_WINDOW_MS=60000

# --- Database (optional locally: prisma loads apps/backend/.env automatically) ---
# Copy the pooled Neon URL from apps/backend/.env if /api/* routes fail without backend running:
# DATABASE_URL=postgresql://...

# --- Google Sheets leads (primary storage when configured) ---
# Spreadsheet: https://docs.google.com/spreadsheets/d/1S0ORdP8VXbcAov1naf-ak7J5HsqSQp-qJLGLSDn-Bfg
# Deploy scripts/google-sheets/lead-webhook.gs as a Web App (see docs/GOOGLE_SHEETS_LEADS.md)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# GOOGLE_SHEETS_WEBHOOK_SECRET=<same as Apps Script WEBHOOK_SECRET property>

# --- Form leads (Neon + email to argroupads@gmail.com) ---
# LEADS_NOTIFY_EMAIL=argroupads@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=<Gmail App Password>
# SMTP_FROM=AR Group of Education <argroupads@gmail.com>
# Optional Resend fallback if Gmail SMTP fails:
# RESEND_API_KEY=
# RESEND_FROM=AR Group Leads <onboarding@resend.dev>
# Vercel Cron — retry emails that failed (generate a random string):
# CRON_SECRET=

# --- Production (Vercel) — API runs on same project (no Railway) ---
# NEXT_PUBLIC_SITE_URL=https://argroupofeducation.com
# DATABASE_URL=<Neon pooled URL — same neondb as before>
# PAYLOAD_SYNC_SECRET=<random>
# Do not set NEXT_PUBLIC_API_URL unless you still use a separate API host
# Do NOT rely on Payload at runtime on Vercel — blogs come from Railway after publish sync:
# PAYLOAD_CMS_ENABLED=false
# CONTENT_SOURCE=api
# REVALIDATE_SECRET=<same as Railway FRONTEND_REVALIDATE + REVALIDATE_SECRET>
# Optional: only if Payload is always online in production:
# NEXT_PUBLIC_CMS_URL=https://your-payload-host.example.com
# PAYLOAD_CMS_URL=https://your-payload-host.example.com
# PAYLOAD_CMS_ENABLED=true

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTAG_ID=

# CMS (Payload — optional; hero forms use built-in fallback when unset)
# NEXT_PUBLIC_CMS_URL=http://localhost:8000
# PAYLOAD_CMS_URL=http://127.0.0.1:8000
# PAYLOAD_CMS_ENABLED=false

# Slug of the Payload `pages` document for `/` and `/home` (default: home). Use e.g. mbbs-india if that is your main CMS page until you create `home`.
# NEXT_PUBLIC_CMS_HOME_SLUG=home

# Draft preview from Payload live preview (create a Users API key in Payload admin)
# PAYLOAD_PREVIEW_API_KEY=

# Must match Payload PREVIEW_SECRET — used by GET /api/draft
# PREVIEW_SECRET=

# Must match Payload FRONTEND_REVALIDATE_SECRET — used by POST /api/revalidate
# REVALIDATE_SECRET=

# Hero MBBS India form (Payload → Forms). Prefer numeric id from the form URL in admin.
# PAYLOAD_MBBS_INDIA_FORM_ID=3
# Or match by title (case-insensitive fallback if exact match fails):
# PAYLOAD_MBBS_INDIA_FORM_TITLE=MBBS INDIA
# Hero MBBS Abroad form (Payload → Forms). Title default MBBS ABROAD.
# PAYLOAD_MBBS_ABROAD_FORM_ID=
# PAYLOAD_MBBS_ABROAD_FORM_TITLE=MBBS ABROAD
# Optional: dedicated Payload form id for the site-load lead popup (falls back to MBBS Abroad form)
# NEXT_PUBLIC_LEAD_CAPTURE_FORM_ID=
# If forms are restricted, use a Users API key:
# PAYLOAD_CMS_API_KEY=

# External Services
NEXT_PUBLIC_CLOUDINARY_NAME=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# YouTube (home page AR Group channel feed — enable YouTube Data API v3 on the key)
# Create key: https://console.cloud.google.com/apis/credentials
# Enable API: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Optional — defaults to @argroupofeducation
# YOUTUBE_CHANNEL_HANDLE=argroupofeducation
# Optional — use if handle lookup fails
# YOUTUBE_CHANNEL_ID=
# Production: feed auto-refreshes every 60s on the live site (no CDN cache). Optional override:
# YOUTUBE_FEED_REFRESH_SECONDS=60

# Google Maps / Reviews (home page Success Stories — enable Places API on the key)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=A R Group of Education Get MBBS Admission Counselling Sector 18 Noida
# Optional: import all Google reviews (Places API returns max 5 per request)
OUTSCRAPER_API_KEY=

# Rank predictor popup — opens first on every page load / navigation (default instant)
# NEXT_PUBLIC_RANK_POPUP_DELAY_MS=0

# Lead counselling popup — auto-opens 5 min after first visit in tab (skipped while a form is in use)
# NEXT_PUBLIC_LEAD_POPUP_DELAY_MS=300000

# NEET Rank Predictor — auto-switch to NTA official marks-vs-rank after re-exam results (default 20 Jul 2026 IST)
# NEET_2026_RESULTS_RELEASE_DATE=2026-07-20T00:00:00+05:30
# FORCE_NEET_OFFICIAL_MODE=true
# FORCE_NEET_EXPECTED_MODE=true

# --- Email OTP (all website forms — verify email before submit) ---
# Set to true to require email OTP before form submit. Off by default.
# NEXT_PUBLIC_EMAIL_OTP_ENABLED=true
# EMAIL_OTP_SECRET=<random-long-string>
# Dev only: use OTP 123456 without sending email
# EMAIL_OTP_DEV=true
#
# Real OTP emails use the same SMTP settings as form leads (set in apps/backend/.env
# or here in .env.local — both are loaded automatically):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=argroupads@gmail.com
# SMTP_PASS=<Gmail App Password — not your Gmail login password>
# SMTP_FROM=AR Group of Education <argroupads@gmail.com>
# OTP sender shown to visitors (separate from lead notification email):
# EMAIL_OTP_FROM=AR Group of Education <info@argroupofeducation.com>

# NEET Rank Predictor — legacy phone OTP (replaced by email OTP above)
# NEET_PREDICTOR_OTP_SECRET=<random-long-string>
# NEET_PREDICTOR_OTP_DEV=true
# Optional SMS webhook POST { phone, otp, template }
# NEET_PREDICTOR_SMS_WEBHOOK_URL=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Site protection — blocks right-click & devtools shortcuts in production (all pages).
# Set to true only for local debugging / admin preview:
# NEXT_PUBLIC_SITE_PROTECTION_DISABLED=true
