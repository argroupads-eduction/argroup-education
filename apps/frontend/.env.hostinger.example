# Hostinger Node.js Web App — copy into hPanel → Environment variables
# (or Import .env). Do NOT commit real secrets.
#
# Full guide: docs/HOSTINGER_DEPLOY.md
# CMS stays on Vercel — only this marketing frontend runs on Hostinger.

NODE_ENV=production

# Hostinger MySQL (Remote MySQL hostname — not localhost)
DATABASE_URL=mysql://USER:PASSWORD@HOSTNAME:3306/DBNAME

NEXT_PUBLIC_SITE_URL=https://www.argroupofeducation.com
NEXT_PUBLIC_SITE_NAME=AR Group of Education

# Do NOT set WP_MEDIA_ORIGIN to www/argroupofeducation.com (self-proxy = very slow 404s).
# Leave unset if media is on disk under public/wp-content/. Only set to a *separate* legacy WP host.
# WP_MEDIA_ORIGIN=

# In-memory HTML page cache (ms). Default in server is 120000 if unset.
HTML_CACHE_TTL_MS=120000

# Shared with Vercel Payload CMS (publish → /api/cms/payload-sync)
REVALIDATE_SECRET=
PAYLOAD_SYNC_SECRET=

# Leave empty on Hostinger — use same-origin /api/*
# NEXT_PUBLIC_API_URL=

# Payload CMS (read-only / optional pull) — stays on Vercel
PAYLOAD_CMS_URL=https://argroup-education-cms-livid.vercel.app
PAYLOAD_CMS_ENABLED=false
CONTENT_SOURCE=api

NEXT_PUBLIC_GA_ID=G-7RW8RDR90K
NEXT_PUBLIC_GTAG_ID=G-7RW8RDR90K

GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
LEADS_NOTIFY_EMAIL=argroupads@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AR Group of Education <argroupads@gmail.com>
EMAIL_OTP_FROM=AR Group of Education <info@argroupofeducation.com>

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:argroupads@gmail.com
PUSH_NOTIFY_SECRET=

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=argroupofeducation
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=A R Group of Education Get MBBS Admission Counselling Sector 18 Noida
CRON_SECRET=

# Do NOT set on Hostinger: AWS_*, AMPLIFY_*, VERCEL, VERCEL_URL
